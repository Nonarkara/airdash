<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Long-term archive for BOTH dashboards → /Volumes/Data/dash-archive.

  SCHEDULE RATIONALE — the 02:00 run is the one that matters.
  Both live systems run retention at 03:00 local (CONFIG.retention.runAtHour),
  which rolls raw readings older than 90 days into hourly means and DELETES
  the raw rows, and deletes events/ingest_runs outright. Archiving at 02:00
  guarantees a full hour of margin: nothing is ever destroyed before it has
  been copied. If you change retention.runAtHour, change this too.

  The other three runs (08/14/20) keep each incremental batch small so a
  single missed night can never turn into a multi-million-row catch-up.

  launchd does NOT start a second instance while one is still running: a
  slot that fires mid-run is silently skipped. If the log shows nothing at
  all for a slot, look for a still-running instance
  (pgrep -fl archive-longterm) before suspecting the schedule.

  Install / reinstall after editing this file (re-bootstrapping KILLS a run
  in progress — watermarks make that safe, but do it between runs):
    cp ops/com.dash.archive.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.dash.archive 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dash.archive.plist
  Run once now (no -k: -k kills a run already in progress):
    launchctl kickstart gui/$(id -u)/com.dash.archive
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dash.archive</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/axiom/AirDash/ops/archive-longterm.mjs</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- Deliberately NOT KeepAlive. This is a batch job: it should run,
       finish, and exit. A crash-restart loop on a job that writes to a
       possibly-unmounted USB volume is how you fill the internal disk
       with logs and take down the live dashboards. The script already
       exits 0 when the volume is absent. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Deliberately NOT LowPriorityIO. That key was here until 2026-09-16
       and it is why the FloodDash phase never finished. On macOS it means
       IOPOL_THROTTLE: the kernel sleeps the process on EVERY disk I/O for
       as long as any other process is using the same device — and the
       archive shares the USB volume with the NSP rsync loops. Measured on
       the archive file itself: 0.7 MB/s throttled vs 20 MB/s normal (30×),
       i.e. ~1.4 s per I/O. Recovering a 94 MB WAL frame-by-frame took
       hours before a single row was copied; the FloodDash phase ran at
       ~500 rows/min instead of ~700k; every run overran the next slot
       (skipped) until a reboot or unmount killed it mid-FloodDash.
       Disk politeness now comes from the script (20k-row batches with a
       yield, 256 MB page cache so it reads far less) plus Nice. -->
  <key>Nice</key>
  <integer>10</integer>

  <!-- SIGTERM (kickstart -k, bootout, shutdown) is handled by the script:
       it finishes the current batch, records "interrupted" in
       archive_runs and exits. Give it long enough to do that on a slow
       disk before launchd escalates to SIGKILL. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Users/axiom/AirDash/logs/archive.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/axiom/AirDash/logs/archive.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/axiom/AirDash</string>
</dict>
</plist>
