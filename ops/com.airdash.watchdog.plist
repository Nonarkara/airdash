<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.airdash.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <!-- node holds the macOS grant for /Volumes/Data; bare /bin/zsh does not,
         so the backup check could never see the USB snapshots (2026-09-28). -->
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/axiom/Projects/_shared/scripts/tcc-run.mjs</string>
    <string>/bin/zsh</string>
    <string>/Users/axiom/AirDash/ops/health-watchdog.sh</string>
  </array>

  <!-- Fires at :00 of every hour, not just "every 3600s since last run"
       (which would drift). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/axiom/AirDash/logs/watchdog-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/axiom/AirDash/logs/watchdog-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
